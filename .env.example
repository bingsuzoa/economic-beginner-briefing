# Copy to .env and fill in. .env is gitignored — never commit real values.

# Required. https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Required when DRY_RUN=false. Any long random string; sent as "Authorization: Bearer <token>"
# on /api/admin/**. A blank value is rejected at startup.
ADMIN_TOKEN=

# PostgreSQL
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/economic_briefing?stringtype=unspecified

# ── SMS 인증 (SOLAPI) ──
SMS_PROVIDER=dev          # dev: 콘솔 로그 출력 | prod: SOLAPI 실제 발송
# SMS_API_KEY=            # SOLAPI API Key (prod에서 필수)
# SMS_API_SECRET=         # SOLAPI API Secret (prod에서 필수)
# SMS_SENDER_NUMBER=      # 발신번호 (사전 등록 필수, prod에서 필수)

# ── Session Cookie (운영 HTTPS에서 아래 값 사용) ──
# SESSION_COOKIE_SECURE=true
# SESSION_COOKIE_SAME_SITE=lax

# Optional
# DRY_RUN=false              # true = mock every external call
# OPENAI_MODEL=gpt-4o        # analysis model
# TEACHER_MODEL=gpt-4o-mini  # per-article classification; keep off the analysis model's TPM budget
# TEACHER_CONCURRENCY=6
# EMBEDDING_ENABLED=true
# ADMIN_PORT=3000
# LOG_LEVEL=INFO
